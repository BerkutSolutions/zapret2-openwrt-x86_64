config zapret2 'main'
    option enabled '1'
    option debug '0'
    option custom_scripts '1'
    option postnat '1'
    option enable_ipv6 '0'
    option filter_ttl_expired_icmp '1'
    option flowoffload 'donttouch'
    option mode_filter 'none'
    option desync_mark '0x40000000'
    option desync_mark_postnat '0x20000000'
    option qnum '300'
    option ws_user 'daemon'
    option nfqws_ports_tcp '80,443'
    option nfqws_ports_udp '443'
    option nfqws_tcp_pkt_out '25'
    option nfqws_tcp_pkt_in '5'
    option nfqws_udp_pkt_out '5'
    option nfqws_udp_pkt_in '3'
    option set_maxelem '522288'
    option gzip_lists '1'
    option mdig_threads '30'
